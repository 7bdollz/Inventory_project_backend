<form method="post" action="/add">
    <label for="title">
        Name:<input type="text" name="title" placeholder="name of game" id="title">
    </label>
    <label for="name">
        Description:<input type="text" name="description" placeholder="describe game" id="description">
    </label>
    <label for="developer">
        Developer:<input type="text" name="developer" placeholder="name of game developer" id="developer">
    </label>
    <label for="quantity">
        Quantity:<input type="number" name="quantity" placeholder="quantity" id="quantity">
    </label>
